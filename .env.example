# Copy to .env and fill in real values. Never commit the real file.

# Async SQLAlchemy connection string for the API's run store.
# Local/dev default matches docker-compose.yml's postgres service.
MF_DATABASE__URL=postgresql+asyncpg://mf_user:mf_pass@localhost:5432/migration_factory

# dev | staging | prod -- gates things like Sentry's traces_sample_rate
# and whether a missing SENTRY_DSN is a warning or just informational.
MF_ENVIRONMENT=dev

# Comma-separated. Auth is fail-closed (see src/migration_factory/api/auth.py):
# with this unset, every /api/v1/* endpoint except /health returns 503.
API_KEYS=dev-key-12345

# Optional. Unset disables Sentry entirely (safe default for local dev).
SENTRY_DSN=

# Optional. "memory://" (default) is correct for a single-instance
# deployment -- only point this at a real store (e.g. Redis) if this ever
# runs multiple instances behind a load balancer.
RATE_LIMIT_STORAGE_URL=memory://
